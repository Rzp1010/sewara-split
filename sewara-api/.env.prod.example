# env PRODUKSI (VPS) — dipasang di /etc/sewara/api.env, mode 600.
# Bukan untuk laptop. Jangan commit.
# config.Load() gagal cepat kalau ada yang kurang, jadi jangan dikosongkan.
# Referensi nama: internal/config/config.go

APP_ENV=production
ADDR=0.0.0.0:4000

# Password HARUS sama dengan /etc/sewara/pg_password (dua tempat, dua-duanya 600).
DATABASE_URL=postgres://sewara:GANTI_PASSWORD@db:5432/sewara?sslmode=disable
SESSION_TTL=720h

# --- Email verifikasi akun (produksi: SMTP wajib) ---
FRONTEND_URL=https://app.sewara.my.id
PUBLIC_API_URL=https://app.sewara.my.id
EMAIL_TOKEN_SECRET=GANTI_acak_panjang
EMAIL_TOKEN_TTL=24h
MAIL_DRIVER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Telegram (internal superadmin, satu bot) ---
WEBHOOK_TELEGRAM_SECRET=GANTI
TELEGRAM_CHAT_ID=-1003838354394
TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_TIMEOUT=10s

# --- Webhook purge ---
PURGE_SECRET=GANTI

# --- Cloudflare R2 (wajib lengkap di produksi) ---
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
