# Salinan untuk docker compose: cp .env.example .env   (.env di-gitignore)
# Nilai di sini khusus DEVELOPMENT. Jangan isi kredensial produksi.
# Referensi nama env: internal/config/config.go.

APP_ENV=development
ADDR=0.0.0.0:4000

# Password Postgres staging. Dipakai service `db` dan disuntik ke DATABASE_URL
# (lihat docker-compose.yml). Produksi: ganti lewat env VPS, jangan file ini.
POSTGRES_PASSWORD=sewara_dev
# Staging lokal — kredensial dev, bukan produksi. Hostname `db` = service compose.
DATABASE_URL=postgres://sewara:sewara_dev@db:5432/sewara?sslmode=disable

# 30 hari
SESSION_TTL=720h

# --- Email verifikasi akun ---
# development: driver `log` (tidak mengirim email sungguhan).
MAIL_DRIVER=log
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8098
EMAIL_TOKEN_SECRET=dev-secret-token-verifikasi
EMAIL_TOKEN_TTL=24h
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# --- Telegram (internal superadmin, satu bot) ---
WEBHOOK_TELEGRAM_SECRET=dev-webhook-telegram
TELEGRAM_CHAT_ID=-1003838354394
TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_TIMEOUT=10s

# --- Webhook pembersihan data (purge) ---
PURGE_SECRET=dev-purge-secret

# --- Cloudflare R2 (foto member, bukti bayar, header invoice) ---
# Kosongkan SEMUA = fitur file mati (balas 503). Terisi sebagian = gagal start.
# Isi lengkap hanya kalau mau menguji jalur file di staging (pakai bucket dev).
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_REGION=auto
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
