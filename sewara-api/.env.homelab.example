# env STAGING HOMELAB (rizkiserver) — dipasang di /etc/sewara/api.env (mode 640 root:sewara).
# Salin berkas ini, isi nilai bertanda GANTI, jangan commit hasil isiannya.
# Nama env diverifikasi dari internal/config/config.go.
#
# Cara pakai: isi di laptop -> scp/paste ke homelab -> `docker compose ... up -d api`
# (lihat docs/docker-runbook.md §/.env untuk perintah tepatnya).

# --- Identitas proses -------------------------------------------------------
# PENTING: docker-compose.prod.yml:82-84 MENIMPA APP_ENV lewat SEWARA_APP_ENV.
#   production   -> cookie sesi Secure. Pakai ini karena homelab diakses via
#                   https://local.sewara.my.id (tunnel Cloudflare).
#   development  -> hanya kalau diakses lewat http langsung (localhost), karena
#                   browser akan menolak cookie Secure dan login gagal.
# Mengubah: jalankan compose dengan SEWARA_APP_ENV=development (bukan di berkas ini).
APP_ENV=production
ADDR=0.0.0.0:4000

# --- Database ---------------------------------------------------------------
# Password harus sama dengan /etc/sewara/pg_password. Jangan tulis di berkas contoh ini.
DATABASE_URL=postgres://sewara:GANTI_PASSWORD@db:5432/sewara?sslmode=disable
SESSION_TTL=720h

# --- Email verifikasi akun --------------------------------------------------
# APP_ENV=production -> default MAIL_DRIVER = smtp, dan SMTP_* WAJIB lengkap.
# Kalau tidak lengkap, config.Load() gagal dan container tidak start.
FRONTEND_URL=https://local.sewara.my.id
PUBLIC_API_URL=https://local.sewara.my.id
EMAIL_TOKEN_SECRET=GANTI_acak_32_karakter_atau_lebih
EMAIL_TOKEN_TTL=24h
MAIL_DRIVER=smtp
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=GANTI_API_KEY_RESEND
# Pengirim harus memakai domain yang sudah diverifikasi di Resend.
# Untuk uji cepat, Resend menyediakan pengirim bawaan onboarding@resend.dev.
SMTP_FROM=Sewara Staging <GANTI_PENGIRIM>

# --- Telegram (notifikasi internal) ----------------------------------------
# Pakai bot/chat staging sendiri, jangan nilai produksi.
WEBHOOK_TELEGRAM_SECRET=GANTI_acak
TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_CHAT_ID=GANTI_chat_id_staging
TELEGRAM_TIMEOUT=10s

# --- Webhook purge ----------------------------------------------------------
PURGE_SECRET=GANTI_acak

# --- Cloudflare R2 (foto bukti bayar, foto member, jaminan, header invoice,
#     snapshot blacklist) ---------------------------------------------------
# Kosongkan SEMUA -> fitur file mati (balas 503). Terisi sebagian -> gagal start.
# Pakai bucket DEV (sewara-dev) dan token yang dibatasi hanya ke bucket itu.
# Tanpa ini, jalur file tidak bisa diuji: unggah bukti, /api/pembayaran/photo,
# foto jaminan, header invoice.
R2_ENDPOINT=https://GANTI_account_id.r2.cloudflarestorage.com
R2_REGION=auto
R2_ACCESS_KEY_ID=GANTI
R2_SECRET_ACCESS_KEY=GANTI
R2_BUCKET=sewara-dev
R2_BUCKET_NAME=sewara-dev

# --- Di luar berkas ini -----------------------------------------------------
# /etc/sewara/rclone.conf masih kosong. Isi hanya kalau mau menguji timer backup;
# kalau tidak, biarkan timer backup mati.
