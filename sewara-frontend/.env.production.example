# ============================================================
# FRONTEND — Production Environment
# Copy ke .env.production (atau .env.local) di server
# JANGAN commit file ini dengan nilai asli ke git
# ============================================================

# Supabase (sama dengan dev — pakai project yang sama)
NEXT_PUBLIC_SUPABASE_URL=https://obhvrzholszhjnpvmnna.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ISI_ANON_KEY_SUPABASE

# Backend API URL — pakai IP/domain server (tanpa trailing slash)
# Kalau pakai Nginx reverse proxy (recommended): sama dengan domain frontend
# Kalau tidak pakai Nginx: http://IP_SERVER:4000
NEXT_PUBLIC_API_URL=http://IP_SERVER_ATAU_DOMAIN

# Owner emails (comma-separated, untuk akses superadmin)
OWNER_EMAILS=ISI_EMAIL_OWNER

# Node environment — WAJIB "development" kalau belum pakai HTTPS
# Ganti ke "production" setelah setup SSL/HTTPS
NODE_ENV=development
