# ============================================================
# FRONTEND — Production Environment
# Copy ke .env.local di server, isi semua nilai yang kosong
# JANGAN commit file ini dengan nilai asli ke git
# ============================================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://obhvrzholszhjnpvmnna.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ISI_ANON_KEY_SUPABASE

# Backend API URL — pakai domain Nginx (same-origin)
# Kalau pakai Nginx (recommended): sama dengan domain frontend (tanpa :port)
# Contoh: https://apps.sewara.my.id
# Kalau TIDAK pakai Nginx: http://IP_SERVER:4000
NEXT_PUBLIC_API_URL=https://apps.sewara.my.id

# Owner emails
OWNER_EMAILS=ISI_EMAIL_OWNER

# Port frontend
PORT=3002

# Node environment
NODE_ENV=production
