# ============================================================
# BACKEND — Production Environment
# Copy ke .env di server, isi semua nilai yang kosong
# JANGAN commit file ini dengan nilai asli ke git
# ============================================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://obhvrzholszhjnpvmnna.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ISI_ANON_KEY_SUPABASE
SUPABASE_SERVICE_ROLE_KEY=ISI_SERVICE_ROLE_KEY

# Owner emails (comma-separated)
OWNER_EMAILS=ISI_EMAIL_OWNER

# Frontend URL — untuk redirect email verification + CORS
# Kalau pakai Nginx (recommended): sama dengan domain frontend
# Tanpa trailing slash
FRONTEND_URL=https://app.sewara.my.id

# Cloudflare R2 (upload foto member)
R2_ENDPOINT=ISI_R2_ENDPOINT
R2_ACCESS_KEY_ID=ISI_R2_ACCESS_KEY
R2_SECRET_ACCESS_KEY=ISI_R2_SECRET_KEY
R2_BUCKET_NAME=ISI_BUCKET_NAME

# Telegram (opsional — notifikasi login)
# TELEGRAM_BOT_TOKEN=ISI_BOT_TOKEN
# TELEGRAM_CHAT_ID=ISI_CHAT_ID

# Port backend — WAJIB sama dengan Nginx proxy_pass target
PORT=4000

# Node environment
# "production" = build Next.js optimized, cookie secure:true
# cookie secure otomatis deteksi HTTPS via x-forwarded-proto header (Nginx/Cloudflare)
NODE_ENV=production
